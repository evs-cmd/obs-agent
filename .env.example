# ═══════════════════════════════════════════════════════════════════════════
# obs-agent — environment configuration
#
# Copy to .env and fill in OPENAI_API_KEY. `.env` is gitignored.
# `make up` auto-creates it from this file if missing.
#
# Docker note: this whole file is loaded into the app container via
# `env_file: - .env`. A few vars are overridden in docker-compose.yml
# (the *_URL ones below) so they use service names instead of localhost —
# those overrides are intentional.
# ═══════════════════════════════════════════════════════════════════════════


# ─── REQUIRED ──────────────────────────────────────────────────────────────

OPENAI_API_KEY=sk-...


# ─── OpenTelemetry tracing (optional) ──────────────────────────────────────
# OTEL_CONSOLE=1 prints spans to stdout. Point OTEL_EXPORTER_OTLP_ENDPOINT
# at an OTLP-HTTP collector to ship them somewhere real.

OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318  # host dev w/ collector
OTEL_SERVICE_NAME=obs-agent
OTEL_CONSOLE=1


# ─── MCP server transport ──────────────────────────────────────────────────
# When set, the app connects to a running MCP server over SSE.
# Empty → app spawns MCP locally as a stdio subprocess.
# In docker compose: overridden to http://mcp:9000/sse.

MCP_SSE_URL=
# MCP_SSE_URL=http://localhost:9000/sse  # host dev w/ MCP in docker


# ─── Self-critique mode (optional) ─────────────────────────────────────────
# When the IncidentAgent synthesis confidence falls below the threshold,
# run a second LLM call to critique the analysis and append findings.
# Trade-off: extra LLM call on low-confidence cases only.

ENABLE_SELF_CRITIQUE=true
SELF_CRITIQUE_THRESHOLD=0.7


# ─── App settings ──────────────────────────────────────────────────────────
# log_level lives in config/app.yaml (observability.log_level).
